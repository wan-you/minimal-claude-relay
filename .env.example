HOST=127.0.0.1
PORT=3000
RELAY_API_KEY=replace-with-the-client-facing-relay-key
ANTHROPIC_API_KEY=replace-with-the-upstream-claude-key
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
# Use authorization when the upstream expects Authorization: Bearer <key>.
ANTHROPIC_AUTH_HEADER=x-api-key
CLAUDE_AUTH_MODE=api
# Set CLAUDE_AUTH_MODE=oauth to use Claude's native OAuth flow.
# Tokens may be supplied here, or obtained through /oauth/authorize and /oauth/exchange.
CLAUDE_OAUTH_ACCESS_TOKEN=
CLAUDE_OAUTH_REFRESH_TOKEN=
CLAUDE_OAUTH_EXPIRES_AT=
CLAUDE_OAUTH_STORE=.oauth-tokens.json
# On macOS, import Claude Code's logged-in OAuth once when the relay store is empty.
CLAUDE_CODE_OAUTH_IMPORT=auto
# Optional when the macOS Keychain account differs from the current user.
CLAUDE_CODE_KEYCHAIN_ACCOUNT=
# Optional override for the Claude Code Keychain service name.
CLAUDE_CODE_KEYCHAIN_SERVICE=Claude Code-credentials
UPSTREAM_TIMEOUT_MS=600000
DEEPSEEK_HARNESS_COMPAT=true
